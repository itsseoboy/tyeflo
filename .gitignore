# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit. Database passwords & keys live here.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch files (root-level only, so future test folders aren't affected)
/local-*
/test
/prompt

# logs
*.log

# AI tool configs
.claude
.z-ai-config

# Skills directory
/skills/
# local archives
*.zip

